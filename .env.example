# Environment variables of D2 Mobile (no value here: copy this file to .env.local if needed).
# The game runs without any variable: `npm ci && npm run dev`.

# --- End-to-end tests (tools/e2e/*) ---
# E2E_URL=                 # URL of the server under test (default: http://127.0.0.1:5233/)
# D2_CHROME=               # path to a Chromium/Chrome if Playwright cannot find its own
# PLAYWRIGHT_BROWSERS_PATH=# folder of the Playwright browsers

# --- The user's own Diablo II files (optional tools, never versioned) ---
# D2_PRIVATE_DIR=          # local root folder (default: ~/d2-private): in/ (MPQ), patch/, out/, audio-in/
# D2_INPUT_DIR=            # folder of the .mpq archives (default: $D2_PRIVATE_DIR/in)
# D2_OUTPUT_DIR=           # output of tools/d2import (default: $D2_PRIVATE_DIR/out)
# D2_GAME_DIR=             # generated "game" folder (default: $D2_OUTPUT_DIR/game)
# D2_PATCH=                # patch archives, separated by ":"
# D2_MAPS=                 # maps generated for the audits (default: $D2_PRIVATE_DIR/out/game/maps)
# D2_LANG=                 # import language (default: eng)
# D2_SPRITES=0             # build/dev: ignore the imported sprites folder
# D2_PUBLIC=1              # "public version" build (no encrypted loader, no guild stash, no sync)
# D2DATA=                  # folder of game tables for the generation scripts tools/itemdata and tools/skilldata
# PD2WIKI=                 # local cache of the wiki pages (mods/pd2/tools/itemdata/pd2wiki.py)

# --- Guild stash (server/guild) ---
# GUILD_API_URL=           # dev: target of the /guild-api proxy (default: http://127.0.0.1:5320); deployment: https://… origin relayed
# GUILD_HOST= GUILD_PORT= GUILD_DATA=   # server/guild service (defaults: 127.0.0.1, 5320, ./.guild-data; GUILD_HOST=0.0.0.0 to expose the service); GUILD_CLIENT_IP, GUILD_TRUSTED_PEERS: see docs/EXPLOITATION-IP.md

# --- Anonymous player counter (server/stats, PRIVACY.md) ---
# STATS_API_URL=           # dev: target of the /stats-api proxy (default: http://127.0.0.1:5330); deployment (--code AND --public): https://… origin relayed; unset: pings have no effect
# STATS_PORT= STATS_HOST= STATS_DATA=   # server/stats service (defaults: 5330, 127.0.0.1, ./.stats-data); STATS_CLIENT_IP, STATS_TRUSTED_PEERS: see docs/EXPLOITATION-IP.md
# STATS_ADMIN_TOKEN=       # service only: token (>= 16 characters) of /stats and /stats.html; never in the repository

# --- Vercel deployment (optional; scripts tools/deploy*.mjs) ---
# VERCEL_TOKEN=            # Vercel token
# VERCEL_SCOPE=            # slug of the team / account
# VERCEL_ORG_ID=  VERCEL_PROJECT_ID=  PUBLIC_VERCEL_PROJECT_ID=   # ids of the full build's project (deploy --code) and of the public build's one (--public); never versioned
# PUBLIC_PROJECT=          # name of the public build's Vercel project (tools/vercel-create-public-project.mjs, default name: diablo2mobile)
# D2_REMOTE_ORIGIN=        # https://… origin relayed by the /d2 rewrite (deploy --code; optional)

# --- Sync API (api/sync.ts, variables of the Vercel project) ---
# SYNC_ALLOWED_ORIGINS=    # allowed CORS origins, comma-separated
# SYNC_MAX_ACCOUNTS= SYNC_MAX_ACCOUNT_BYTES=   # storage caps of the sync (defaults: 200 accounts, 16777216 bytes per account)
# SYNC_PEPPER=             # server secret (pepper) for the authentication fingerprints
# BLOB_READ_WRITE_TOKEN=   # Vercel Blob storage
